
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,

    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
